# Copy to the project root as .env when running via docker-compose.yml in this folder.
# The key difference from a bare-metal .env: hosts are Docker service names, not 127.0.0.1.

APP_NAME=MyApp
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel_db
DB_USERNAME=laravel
DB_PASSWORD=password123
DB_ROOT_PASSWORD=rootpassword123

CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

VITE_DEV_SERVER_URL=http://localhost:5173
